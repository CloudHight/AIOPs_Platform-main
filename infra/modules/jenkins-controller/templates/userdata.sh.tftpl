#!/bin/bash
set -Eeuxo pipefail

exec > >(tee /var/log/jenkins-bootstrap.log | logger -t jenkins-bootstrap -s 2>/dev/console) 2>&1
trap 'echo "ERROR: bootstrap failed on line $LINENO"' ERR

echo "--- Starting Jenkins Bootstrap: $(date) ---"

dnf update -y

# Amazon Linux 2023 ships with curl-minimal by default.
# Do NOT install the full "curl" package unless you intentionally swap curl-minimal out.
dnf install -y \
  ca-certificates \
  curl-minimal \
  git \
  fontconfig \
  java-21-amazon-corretto-headless \
  jq \
  python3 \
  python3-pip \
  python3-virtualenv \
  unzip \
  zip \
  xfsprogs \
  docker \
  amazon-cloudwatch-agent

systemctl enable --now docker

# Jenkins official RPM repository
curl -fsSL https://pkg.jenkins.io/rpm-stable/jenkins.repo \
  -o /etc/yum.repos.d/jenkins.repo

dnf makecache -y
dnf install -y jenkins

systemctl daemon-reload
systemctl enable --now jenkins
systemctl enable --now amazon-cloudwatch-agent

usermod -aG docker jenkins

TERRAFORM_VERSION="1.11.1"
curl -fsSL "https://releases.hashicorp.com/terraform/$${TERRAFORM_VERSION}/terraform_$${TERRAFORM_VERSION}_linux_amd64.zip" \
  -o /tmp/terraform.zip
unzip -o /tmp/terraform.zip -d /usr/local/bin
chmod +x /usr/local/bin/terraform
rm -f /tmp/terraform.zip

ARCH="$(uname -m)"
if [ "$ARCH" = "x86_64" ]; then
  AWSCLI_ARCH="x86_64"
else
  AWSCLI_ARCH="aarch64"
fi

curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$${AWSCLI_ARCH}.zip" \
  -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install --bin-dir /usr/local/bin --install-dir /usr/local/aws-cli --update
rm -rf /tmp/aws /tmp/awscliv2.zip

cat >/etc/motd <<'EOF'
AIOps Jenkins controller

Access:
- Prefer SSM Session Manager for administration.
- Jenkins listens on port 8080 only if the security group allows your CIDR.

Initial admin password:
sudo cat /var/lib/jenkins/secrets/initialAdminPassword

Required Jenkins credentials:
- aws-deploy-role-arn-dev
- aws-deploy-role-arn-stage
- aws-deploy-role-arn-prod
- model-artifact-bucket
- lambda-artifact-bucket
EOF

echo "--- Jenkins Bootstrap Completed Successfully: $(date) ---"
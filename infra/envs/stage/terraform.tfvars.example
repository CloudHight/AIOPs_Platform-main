aws_region                   = "us-east-1"
environment                  = "stage"
allowed_http_cidrs           = []
workload_instance_type       = "t3.medium"
workload_app_image           = "cloudhight/testapp:latest"
workload_associate_public_ip = false
workload_log_retention_days  = 60

enable_aiops_control_plane     = false
notification_email             = null
cpu_model_endpoint             = "cpu-anomaly-model-endpoint"
log_model_endpoint             = "log-anomaly-model-endpoint"
jira_project_key               = "PROJ"
monitoring_frequency           = "rate(5 minutes)"
cpu_threshold                  = 0.85
log_threshold                  = 0.8
grace_period_minutes           = 15
auto_remediation_enabled       = false
dry_run                        = true
max_remediation_attempts       = 1
remediation_cooldown_minutes   = 60

# Required only when enable_aiops_control_plane = true.
lambda_artifact_bucket    = null
lambda_artifact_key       = null
lambda_artifact_version   = null
lambda_source_code_hash   = null
lambda_local_package_path = null

enable_sagemaker_endpoints = false
model_version              = "local"
cpu_model_artifact_s3_uri  = null
log_model_artifact_s3_uri  = null
cpu_model_image_uri        = null
log_model_image_uri        = null
cpu_endpoint_instance_type = "ml.m5.large"
log_endpoint_instance_type = "ml.g5.xlarge"
